<Window x:Class="MftSearchWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MftSearchWpf"
        xmlns:vm="clr-namespace:MftSearchWpf.ViewModels"
        mc:Ignorable="d"
        Name="RootWindow"
        Title="Tachyon" Height="600" Width="900"
        Background="#1e1e1e" Foreground="White" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <TextBox Grid.Row="0"
                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="24" Padding="10" Margin="0,0,0,10"
                 Background="#2d2d30" Foreground="White" BorderBrush="#3f3f46" BorderThickness="1"
                 IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}"/>

        <!-- Results View - Utilizing Virtualization -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding FilteredRecords}"
                  Background="#1e1e1e" Foreground="LightGray"
                  BorderBrush="#3f3f46" BorderThickness="1"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="250" DisplayMemberBinding="{Binding FileName}" />
                    <GridViewColumn Header="Path" Width="600" DisplayMemberBinding="{Binding FullPath}" />
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="LightGray" />
                    <!-- Bind the DataContext of the Window to the Tag so the ContextMenu can access it -->
                    <Setter Property="Tag" Value="{Binding DataContext, ElementName=RootWindow}" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Copy Full Path"
                                          Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Open File Location"
                                          Command="{Binding PlacementTarget.Tag.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="Calculate SHA256 &#38; Copy"
                                          Command="{Binding PlacementTarget.Tag.CopyHashCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Check VirusTotal"
                                          Command="{Binding PlacementTarget.Tag.CheckVirusTotalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="Black" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="Black" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#007acc" Foreground="White" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
